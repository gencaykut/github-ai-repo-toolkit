{
  "manifest_version": 3,
  "name": "GitHub AI Repo Toolkit",
  "version": "4.0.0",
  "description": "Generate AI-friendly repo links and localized technical-analysis prompts from GitHub repositories.",
  "permissions": ["activeTab", "clipboardWrite", "storage"],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub AI Repo Toolkit",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  }
}
